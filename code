def save_fig(fig, out_dir, name):
    fig.savefig(os.path.join(out_dir, name + '.png'), dpi=300); fig.savefig(os.path.join(out_dir, name + '.pdf')); plt.close(fig)


def main():
    in_csv = sys.argv[1] if len(sys.argv) > 1 else '06_fused_railway_disaster_dataset.csv'
    out_dir = sys.argv[2] if len(sys.argv) > 2 else 'output'
    tab = os.path.join(out_dir, 'tables'); os.makedirs(tab, exist_ok=True)
    log = open(os.path.join(out_dir, 'results_summary.txt'), 'w')
    def say(*a):
        s = ' '.join(str(x) for x in a); print(s); log.write(s + '\n'); log.flush()

    df = pd.read_csv(in_csv)
    if 'Procurement_Complexity' in df.columns: df = df.drop(columns=['Procurement_Complexity'])
    y = df[TARGET].values.astype(float); cor = df[CORR].values; tri = df[TRI].values; cls = (tri == 2).astype(int)
    corrs = list(df[CORR].unique())

    say('N =', len(df), '| corridors =', len(corrs))
    say('Outcome: mean %.1f median %.1f sd(ddof1) %.1f sd(ddof0) %.1f skew(bias-corrected) %.3f exkurt(bias-corrected) %.3f' % (
        y.mean(), np.median(y), y.std(ddof=1), y.std(), stats.skew(y, bias=False), stats.kurtosis(y, bias=False)))
    for k in (1, 2):
        v = y[tri == k]; say('Class %d: n=%d mean %.1f median %.1f sd(ddof1) %.1f sd(ddof0) %.1f' % (k, len(v), v.mean(), np.median(v), v.std(ddof=1) if len(v) > 1 else 0, v.std()))
    say(df.groupby(CORR, sort=False).agg(n=(TARGET, 'size'), PGA=('PGA_g', 'mean'), PGV=('PGV_cms', 'mean'), T=(TARGET, 'mean')).round(2).to_string())
    sp = []
    for f in ['PGV_cms', 'PGA_g', 'Liquefaction_Severity', 'Fault_Rupture_Crossing', 'Track_Buckling_S_Curve', 'Bridge_Bearing_Failure']:
        r, p = stats.spearmanr(df['Equipment_Access_Blockage'], df[f]); sp.append({'Predictor': f, 'rho': round(r, 3), 'p': p})
    pd.DataFrame(sp).to_csv(os.path.join(tab, 'spearman_access_vs_physical.csv'), index=False); say(pd.DataFrame(sp).round(4).to_string())
    c2 = df[tri == 2]; w = []
    for f in ['PGA_g', 'PGV_cms']:
        r, p = stats.spearmanr(c2[f], c2[TARGET]); w.append({'Predictor': f, 'rho_within_Class2': round(r, 3), 'p': round(p, 3), 'N': len(c2)})
    pd.DataFrame(w).to_csv(os.path.join(tab, 'spearman_within_class2.csv'), index=False); say(pd.DataFrame(w).to_string())
    say('Shapiro-Wilk on ln(Class 2 durations): W=%.3f p=%.2e' % stats.shapiro(np.log(y[tri == 2])))

    specs = {'Ground Motion Only (RF)': ['PGA_g', 'PGV_cms'], 'Physical & Logistical (RF)': PHYS,
             'Initial Triage & Access (RF)': [TRI, 'Equipment_Access_Blockage'], 'Full Fused (RF)': FULL}
    res = {k: evaluate_loco_rf(df, v) for k, v in specs.items()}
    preds = {k: v['pred'] for k, v in res.items()}
    preds['Decision Stump'] = stump_loco(df)
    hp, hP = hurdle_loco(df, 'mean'); preds['Two-Stage Hurdle'] = hp
