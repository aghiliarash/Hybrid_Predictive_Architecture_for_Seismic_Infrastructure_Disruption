#!/usr/bin/env python3
"""
Post-Disaster Railway Infrastructure Recovery Analysis (Leak-Free and Non-Circular)
Case study: 2023 Kahramanmaras earthquake sequence, Turkiye

Self-contained replication script (version 2, includes robustness checks).
Dependencies: numpy, pandas, scipy, matplotlib.
Usage:  python 05_final_model_and_figures.py [data.csv] [output_dir]

It reproduces every numerical result reported in the article and its supplement:
  1. Descriptive statistics and Spearman associations
  2. Leave-one-corridor-out (LOCO) Random Forest benchmarks (Regime A and Regime B)
  3. Decision Stump and Two-Stage Hurdle comparators (including retransformation variants)
  4. Segment-level and cluster-block bootstrap intervals (1,000 resamples, seed 42)
  5. Out-of-fold (frozen-model) permutation importance and global-refitting importance
  6. Milestone, hyperparameter and multi-seed sensitivity analyses
  7. Full-register L2 logit, univariate probit fragility fits and fit measures
  8. Robustness checks: training-mean baseline and skill scores, exact corridor-label
     permutation test for the triage rule, intra-corridor correlation and effective sample size,
     and leave-two-corridors-out validation
  9. 300 dpi figures (PNG and PDF)
Permutation convention: each predictor column is permuted across all 51 segments, and the
frozen fold models are re-scored on their held-out corridors.
"""
import os, sys, itertools
import numpy as np
import pandas as pd
from scipy import optimize, stats
import matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt

TARGET = 'Empirical_Downtime_Days'
CORR = 'Operational_Corridor'
TRI = 'Initial_Damage_Triage_Class'
FULL = ['PGA_g', 'PGV_cms', 'Fault_Rupture_Crossing', 'Liquefaction_Severity',
        'Track_Buckling_S_Curve', 'Bridge_Bearing_Failure', 'Equipment_Access_Blockage', TRI]
PHYS = FULL[:-1]
SEEDS = [42, 105, 216, 327, 438, 549, 660, 771, 882, 909]


class FastDecisionTreeRegressor:
    def __init__(self, max_depth=4, min_samples_split=4, min_samples_leaf=2, max_features=None, random_state=None):
        self.max_depth = max_depth; self.min_samples_split = min_samples_split
        self.min_samples_leaf = min_samples_leaf; self.max_features = max_features
        self.random_state = random_state; self.tree = None

    def fit(self, X, y):
        rng = np.random.RandomState(self.random_state)
        self.tree = self._build(X, y, 0, rng)
        return self

    def _build(self, X, y, depth, rng):
        n_samples, n_features = X.shape
        if depth >= self.max_depth or n_samples < self.min_samples_split or np.var(y) < 1e-7:
            return ('leaf', float(np.mean(y)))
        feat_indices = np.arange(n_features) if self.max_features is None else \
            rng.choice(n_features, size=min(self.max_features, n_features), replace=False)
        best_feat, best_thresh, best_score, best_left = None, None, float('inf'), None
        y_sum, y_sq = np.sum(y), np.sum(y * y)
        for f in feat_indices:
            col = X[:, f]; vals = np.unique(col)
            if len(vals) <= 1: continue
            th = (vals[:-1] + vals[1:]) / 2.0
            masks = col[None, :] <= th[:, None]
            n_l = np.sum(masks, axis=1); n_r = n_samples - n_l
            valid = (n_l >= self.min_samples_leaf) & (n_r >= self.min_samples_leaf)
            if not np.any(valid): continue
            mv, nl, nr, tv = masks[valid], n_l[valid], n_r[valid], th[valid]
            sl, ql = mv @ y, mv @ (y * y); sr, qr = y_sum - sl, y_sq - ql
            sc = (ql - sl * sl / nl) + (qr - sr * sr / nr)
            k = int(np.argmin(sc))
            if sc[k] < best_score - 1e-12:
                best_score, best_feat, best_thresh, best_left = float(sc[k]), int(f), float(tv[k]), mv[k]
        if best_feat is None: return ('leaf', float(np.mean(y)))
        return ('node', best_feat, best_thresh,
                self._build(X[best_left], y[best_left], depth + 1, rng),
                self._build(X[~best_left], y[~best_left], depth + 1, rng))

    def predict(self, X): return np.array([self._pred(r, self.tree) for r in X])

    def _pred(self, row, node):
        if node[0] == 'leaf': return node[1]
        return self._pred(row, node[3]) if row[node[1]] <= node[2] else self._pred(row, node[4])


class FastRandomForestRegressor:
    def __init__(self, n_estimators=100, max_depth=4, min_samples_split=4, min_samples_leaf=2,
                 max_features='sqrt', random_state=42):
        self.n_estimators = n_estimators; self.max_depth = max_depth
        self.min_samples_split = min_samples_split; self.min_samples_leaf = min_samples_leaf
        self.max_features = max_features; self.random_state = random_state; self.trees = []

    def fit(self, X, y):
        rng = np.random.RandomState(self.random_state); n, p = X.shape
        mf = max(1, int(np.sqrt(p))) if self.max_features == 'sqrt' else p
        self.trees = []
        for _ in range(self.n_estimators):
            idx = rng.choice(n, size=n, replace=True); seed = rng.randint(0, 1000000)
            t = FastDecisionTreeRegressor(self.max_depth, self.min_samples_split, self.min_samples_leaf, mf, seed)
            self.trees.append(t.fit(X[idx], y[idx]))
        return self

    def predict(self, X): return np.mean([t.predict(X) for t in self.trees], axis=0)


def r2_score_pure(y, p):
    return float(1.0 - np.sum((y - p) ** 2) / np.sum((y - np.mean(y)) ** 2))


def summarize(df, pred):
    y = df[TARGET].values.astype(float); tri = df[TRI].values; cor = df[CORR].values
    a = pd.DataFrame({'c': cor, 'o': y, 'p': pred}).groupby('c', sort=False).mean()
    e = np.abs(y - pred)
    return dict(corridor_r2=r2_score_pure(a.o.values, a.p.values), block_r2=r2_score_pure(y, pred),
                mae=float(e.mean()), medae=float(np.median(e)), rmse=float(np.sqrt(np.mean((y - pred) ** 2))),
                class1_mae=float(e[tri == 1].mean()), class2_mae=float(e[tri == 2].mean()))


def evaluate_loco_rf(df, features, max_depth=4, n_estimators=100, random_state=42):
    X = df[features].values.astype(float); y = df[TARGET].values.astype(float)
    preds = np.zeros(len(y)); fold_models = {}; audit = []
    for c in df[CORR].unique():
        te = (df[CORR] == c).values; tr = ~te
        rf = FastRandomForestRegressor(n_estimators, max_depth, 4, 2, 'sqrt', random_state).fit(X[tr], y[tr])
        fold_models[c] = (rf, te); preds[te] = rf.predict(X[te])
        audit.append({'Held_Out_Corridor': c, 'N_Segments': int(te.sum()),
                      'Observed_Mean_Days': round(float(y[te].mean()), 1),
                      'Predicted_Mean_Days': round(float(preds[te].mean()), 1),
                      'Absolute_Error_Days': round(abs(float(y[te].mean()) - float(preds[te].mean())), 1)})
    out = summarize(df, preds); out.update(pred=preds, fold_models=fold_models, audit_df=pd.DataFrame(audit))
    return out


def stump_predict(y, tri, tr, te):
    p = np.zeros(len(y))
    for k in (1, 2):
        p[te & (tri == k)] = y[tr][tri[tr] == k].mean()
    return p


def stump_loco(df, tri=None):
    y = df[TARGET].values.astype(float); tri = df[TRI].values if tri is None else tri; cor = df[CORR].values; p = np.zeros(len(y))
    for c in df[CORR].unique():
        te = cor == c; tr = ~te
        p[te] = stump_predict(y, tri, tr, te)[te]
    return p


def fit_logit_l2(Z, t, C=1.0, balanced=False):
    """min 0.5*||w||^2 + C*sum s_i*log(1+exp(-ytilde_i*(b+z_i.w))); intercept unpenalised."""
    n, p = Z.shape; yt = np.where(t == 1, 1.0, -1.0)
    s = np.ones(n)
    if balanced:
        for k in (0, 1): s[t == k] = n / (2.0 * np.sum(t == k))
    def f(th):
        m = yt * (th[0] + Z @ th[1:]); return 0.5 * th[1:] @ th[1:] + C * np.sum(s * np.logaddexp(0, -m))
    def g(th):
        m = yt * (th[0] + Z @ th[1:]); q = -s * yt / (1 + np.exp(m))
        return np.concatenate([[C * q.sum()], th[1:] + C * Z.T @ q])
    r = optimize.minimize(f, np.zeros(p + 1), jac=g, method='BFGS', options={'gtol': 1e-10, 'maxiter': 2000})
    return r.x


def predict_logit(th, Z): return 1.0 / (1.0 + np.exp(-(th[0] + Z @ th[1:])))


def auc_score(t, s):
    r = stats.rankdata(s); n1 = np.sum(t == 1); n0 = np.sum(t == 0)
    return float((r[t == 1].sum() - n1 * (n1 + 1) / 2) / (n1 * n0))


def hurdle_predict(df, tr, te, mode='mean', balanced=False):
    Xp = df[PHYS].values.astype(float); y = df[TARGET].values.astype(float); cls = (df[TRI].values == 2).astype(int)
    mu, sd = Xp[tr].mean(0), Xp[tr].std(0); sd[sd == 0] = 1
    Z = (Xp - mu) / sd; th = fit_logit_l2(Z[tr], cls[tr], 1.0, balanced); P = predict_logit(th, Z)
    ly = np.log(y[tr][cls[tr] == 1]); m2, v2 = ly.mean(), ly.var()
    c2 = {'mean': np.exp(m2 + 0.5 * v2), 'median': np.exp(m2),
          'shifted': 365 + np.exp(np.mean(np.log(np.maximum(y[tr][cls[tr] == 1] - 365, 1))))}[mode]
    return np.where(P >= 0.5, c2, y[tr][cls[tr] == 0].mean()), P


def hurdle_loco(df, mode='mean', balanced=False):
    cor = df[CORR].values; pred = np.zeros(len(df)); P = np.zeros(len(df))
    for c in df[CORR].unique():
        te = cor == c; tr = ~te
        p_, P_ = hurdle_predict(df, tr, te, mode, balanced); pred[te] = p_[te]; P[te] = P_[te]
    return pred, P


def probit_fit(x, t):
    X = np.c_[np.ones(len(x)), np.log(x)]
    def nll(b):
        q = np.clip(stats.norm.cdf(X @ b), 1e-12, 1 - 1e-12); return -np.sum(t * np.log(q) + (1 - t) * np.log(1 - q))
    def grad(b):
        eta = X @ b; q = np.clip(stats.norm.cdf(eta), 1e-12, 1 - 1e-12); ph = stats.norm.pdf(eta)
        return -X.T @ (ph * (t - q) / (q * (1 - q)))
    b = optimize.minimize(nll, np.array([0.0, 1.0]), jac=grad, method='BFGS', options={'gtol': 1e-10}).x
    H = np.zeros((2, 2)); h = 1e-5
    for i in range(2):
        d = np.zeros(2); d[i] = h; H[:, i] = (grad(b + d) - grad(b - d)) / (2 * h)
    cov = np.linalg.inv((H + H.T) / 2); b0, b1 = b
    gt = np.array([-1 / b1, b0 / b1 ** 2]); gb = np.array([0.0, -1 / b1 ** 2])
    p1 = np.mean(t); ll0 = len(t) * (p1 * np.log(p1) + (1 - p1) * np.log(1 - p1))
    return dict(theta=-b0 / b1, se_theta=float(np.sqrt(gt @ cov @ gt)), beta=1 / b1, se_beta=float(np.sqrt(gb @ cov @ gb)),
                median=float(np.exp(-b0 / b1)), mcfadden=float(1 - nll(b) / -ll0), auc=auc_score(t, stats.norm.cdf(X @ b)))


def probit_loco(x, t, cor):
    P = np.zeros(len(x))
    for c in np.unique(cor):
        te = cor == c; tr = ~te
        X = np.c_[np.ones(tr.sum()), np.log(x[tr])]
        def nll(b):
            q = np.clip(stats.norm.cdf(X @ b), 1e-12, 1 - 1e-12); return -np.sum(t[tr] * np.log(q) + (1 - t[tr]) * np.log(1 - q))
        b = optimize.minimize(nll, np.array([0.0, 1.0]), method='BFGS', options={'gtol': 1e-9}).x
        P[te] = stats.norm.cdf(b[0] + b[1] * np.log(x[te]))
    return P


def bootstrap_ci(df, pred, B=1000, seed=42):
    y = df[TARGET].values.astype(float); cor = df[CORR].values; n = len(y)
    groups = {c: np.where(cor == c)[0] for c in df[CORR].unique()}; keys = list(groups)
    rng = np.random.RandomState(seed); seg_r2, seg_mae = [], []
    for _ in range(B):
        i = rng.choice(n, n, replace=True); seg_r2.append(r2_score_pure(y[i], pred[i])); seg_mae.append(np.mean(np.abs(y[i] - pred[i])))
    rng = np.random.RandomState(seed); clu_mae = []
    for _ in range(B):
        j = np.concatenate([groups[keys[k]] for k in rng.choice(len(keys), len(keys), replace=True)])
        clu_mae.append(np.mean(np.abs(y[j] - pred[j])))
    q = lambda a: tuple(np.round(np.percentile(a, [2.5, 97.5]), 3))
    return dict(seg_r2_ci=q(seg_r2), seg_mae_ci=q(seg_mae), cluster_mae_ci=q(clu_mae))


def oof_permutation(df, feats, res, seed=42, reps=10):
    X = df[feats].values.astype(float); y = df[TARGET].values.astype(float)
    base = res['rmse'] ** 2; rng = np.random.RandomState(seed); rec = []
    for j, f in enumerate(feats):
        inc = []
        for _ in range(reps):
            Xq = X.copy(); Xq[:, j] = rng.permutation(X[:, j]); pp = np.zeros(len(y))
            for c, (rf, te) in res['fold_models'].items(): pp[te] = rf.predict(Xq[te])
            inc.append((np.mean((y - pp) ** 2) - base) / base)
        rec.append({'Feature': f, 'OOF_Mean_Delta_MSE': round(float(np.mean(inc)), 3), 'OOF_Std_Dev': round(float(np.std(inc)), 3)})
    return pd.DataFrame(rec).sort_values('OOF_Mean_Delta_MSE', ascending=False)


def refit_permutation(df, feats, base_rmse, seed=42, reps=10):
    rng = np.random.RandomState(seed); base = base_rmse ** 2; rec = []
    for f in feats:
        inc = []
        for _ in range(reps):
            d2 = df.copy(); d2[f] = rng.permutation(df[f].values)
            inc.append((evaluate_loco_rf(d2, feats)['rmse'] ** 2 - base) / base)
        rec.append({'Feature': f, 'Refit_Mean_Delta_MSE': round(float(np.mean(inc)), 3), 'Refit_Std_Dev': round(float(np.std(inc)), 3)})
    return pd.DataFrame(rec).sort_values('Refit_Mean_Delta_MSE', ascending=False)


# ------------------------------------------------------------------ robustness checks
def baseline_loco(df):
    y = df[TARGET].values.astype(float); cor = df[CORR].values; p = np.zeros(len(y))
    for c in df[CORR].unique():
        te = cor == c; p[te] = y[~te].mean()
    return p


def skill_table(df, preds):
    y = df[TARGET].values.astype(float); base = preds['Training-mean baseline']
    mse_b, mae_b = np.mean((y - base) ** 2), np.mean(np.abs(y - base)); rows = []
    for k, p in preds.items():
        m = summarize(df, p)
        rows.append({'Model': k, 'MAE': round(m['mae'], 1), 'RMSE': round(m['rmse'], 1), 'Block_R2': round(m['block_r2'], 3),
                     'MSE_skill_vs_baseline': round(1 - np.mean((y - p) ** 2) / mse_b, 3), 'MAE_skill_vs_baseline': round(1 - m['mae'] / mae_b, 3)})
    return pd.DataFrame(rows)


def triage_label_permutation(df):
    """Exact test: relabel which 2 of the 7 corridors are Class 1 (21 assignments) and re-run the LOCO stump."""
    y = df[TARGET].values.astype(float); cor = df[CORR].values; corrs = list(df[CORR].unique()); rows = []
    obs_set = set(df.loc[df[TRI] == 1, CORR].unique())
    for pair in itertools.combinations(corrs, 2):
        tri_p = np.where(np.isin(cor, pair), 1, 2); p = stump_loco(df, tri_p)
        rows.append({'Class1_corridors': ' + '.join(pair), 'Observed_assignment': set(pair) == obs_set,
                     'Block_R2': r2_score_pure(y, p), 'MAE': float(np.mean(np.abs(y - p)))})
    t = pd.DataFrame(rows); o = t[t.Observed_assignment].iloc[0]
    t.attrs['p_mae'] = float(np.mean(t.MAE <= o.MAE + 1e-9)); t.attrs['p_r2'] = float(np.mean(t.Block_R2 >= o.Block_R2 - 1e-12))
    return t


def icc_oneway(df):
    y = df[TARGET].values.astype(float); g = df[CORR].values; N = len(y); ks = list(df[CORR].unique()); K = len(ks)
    ni = np.array([np.sum(g == k) for k in ks]); means = np.array([y[g == k].mean() for k in ks]); gm = y.mean()
    msb = np.sum(ni * (means - gm) ** 2) / (K - 1); msw = sum(np.sum((y[g == k] - m) ** 2) for k, m in zip(ks, means)) / (N - K)
    k0 = (N - np.sum(ni ** 2) / N) / (K - 1); icc = (msb - msw) / (msb + (k0 - 1) * msw)
    de = 1 + (N / K - 1) * icc
    return dict(ICC=float(icc), design_effect=float(de), effective_N=float(N / de), mean_cluster_size=float(N / K))


def leave_two_out(df):
    y = df[TARGET].values.astype(float); cor = df[CORR].values; corrs = list(df[CORR].unique()); tri = df[TRI].values
    specs = {'Ground Motion Only (RF)': ['PGA_g', 'PGV_cms'], 'Physical & Logistical (RF)': PHYS,
             'Initial Triage & Access (RF)': [TRI, 'Equipment_Access_Blockage'], 'Full Fused (RF)': FULL}
    acc = {k: [] for k in list(specs) + ['Decision Stump', 'Two-Stage Hurdle', 'Training-mean baseline']}; used = 0
    for pair in itertools.combinations(corrs, 2):
        te = np.isin(cor, pair); tr = ~te
        if len(set(tri[tr])) < 2: continue
        used += 1
        for k, fs in specs.items():
            X = df[fs].values.astype(float)
            acc[k].append((te, FastRandomForestRegressor(100, 4, 4, 2, 'sqrt', 42).fit(X[tr], y[tr]).predict(X[te])))
        acc['Decision Stump'].append((te, stump_predict(y, tri, tr, te)[te]))
        acc['Two-Stage Hurdle'].append((te, hurdle_predict(df, tr, te)[0][te]))
        acc['Training-mean baseline'].append((te, np.full(te.sum(), y[tr].mean())))
    rows = []
    for k, lst in acc.items():
        maes = [np.mean(np.abs(y[te] - p)) for te, p in lst]
        yy = np.concatenate([y[te] for te, p in lst]); pp = np.concatenate([p for te, p in lst])
        rows.append({'Model': k, 'Pairs': used, 'Mean_pair_MAE': round(float(np.mean(maes)), 1), 'Min_pair_MAE': round(float(np.min(maes)), 1),
                     'Max_pair_MAE': round(float(np.max(maes)), 1), 'Pooled_block_R2': round(r2_score_pure(yy, pp), 3)})
    return pd.DataFrame(rows)


