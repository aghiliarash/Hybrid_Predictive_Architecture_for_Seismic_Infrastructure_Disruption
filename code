def safe_shap_values(model, X):
    """Calculates robust exact Shapley values."""
    if not SHAP_AVAILABLE:
        raise ImportError("SHAP is not installed.")
    explainer = shap.TreeExplainer(model)
    values = explainer.shap_values(X)
    if isinstance(values, list):
        values = values[1]
    return values


# =============================================================================
# 2. COPULA CORRELATION MATRICES
# =============================================================================

# Define Target Rank Correlations (Spearman)
physical_corr_target = np.array([
    [1.00, -0.55,  0.65,  0.58],
    [-0.55, 1.00, -0.60, -0.52],
    [0.65, -0.60,  1.00,  0.82],
    [0.58, -0.52,  0.82,  1.00]
])
physical_corr_labels = ["Mw", "fault_distance_km", "PGA", "PGV"]

governance_corr_target = np.array([
    [1.00, -0.35,  0.40,  0.45],
    [-0.35, 1.00, -0.30, -0.25],
    [0.40, -0.30,  1.00,  0.30],
    [0.45, -0.25,  0.30,  1.00]
])
governance_corr_labels = ["approval_backlog", "contractor_mobilization_index", "historical_downtime", "active_approval_authorities"]

safe_to_csv(pd.DataFrame(physical_corr_target, index=physical_corr_labels, columns=physical_corr_labels), "Target_Physical_Copula_Correlation.csv")
safe_to_csv(pd.DataFrame(governance_corr_target, index=governance_corr_labels, columns=governance_corr_labels), "Target_Governance_Copula_Correlation.csv")


# =============================================================================
# 3. SCENARIO GENERATION (N=10,000)
# =============================================================================

print(f"\n[INFO] Generating {N_SCENARIOS} simulated disruption scenarios...")

# Physical Sampling
u_phys = gaussian_copula_samples(n=N_SCENARIOS, corr=physical_corr_target, random_state=RANDOM_SEED)
Mw = truncnorm.ppf(u_phys[:, 0], a=(5.0 - 6.3)/0.55, b=(7.5 - 6.3)/0.55, loc=6.3, scale=0.55)
fault_distance_km = lognorm.ppf(u_phys[:, 1], s=0.45, scale=np.exp(np.log(35)))
PGA = lognorm.ppf(u_phys[:, 2], s=0.35, scale=np.exp(np.log(0.22)))
PGV = lognorm.ppf(u_phys[:, 3], s=0.40, scale=np.exp(np.log(22)))

# Governance Sampling
u_gov = gaussian_copula_samples(n=N_SCENARIOS, corr=governance_corr_target, random_state=RANDOM_SEED + 1)
approval_backlog = nbinom.ppf(u_gov[:, 0], n=3, p=0.4).astype(int)
contractor_mobilization_index = uniform.ppf(u_gov[:, 1], loc=0.4, scale=0.5)
historical_downtime = gamma.ppf(u_gov[:, 2], a=2.1, scale=1.8)
active_approval_authorities = poisson.ppf(u_gov[:, 3], mu=4.2).astype(int)

# Contextual Sampling
event_season = rng.integers(1, 5, size=N_SCENARIOS)
winter_season = np.where(event_season == 1, 1, 0)
maintenance_late = bernoulli.rvs(0.35, size=N_SCENARIOS, random_state=RANDOM_SEED + 2)
soil_class = rng.choice([0, 1, 2], size=N_SCENARIOS, p=[0.35, 0.45, 0.20])
soil_soft = np.where(soil_class == 2, 1, 0)


# =============================================================================
# 4. NON-LINEAR DATA-GENERATING PROCESS (DGP)
# =============================================================================

# Standardize variables for DGP processing
z_PGA, z_PGV, z_FD = zscore(PGA), zscore(PGV), zscore(fault_distance_km)
z_AB, z_CMI, z_HD, z_AA = zscore(approval_backlog), zscore(contractor_mobilization_index), zscore(historical_downtime), zscore(active_approval_authorities)

epsilon = rng.normal(loc=0.0, scale=1.25, size=N_SCENARIOS)

# Non-linear threshold: Governance bottlenecks compound severely ONLY IF physical damage is high
governance_penalty = np.where(
    z_PGA > 0.5,
    (1.80 * z_AB) - (1.20 * z_CMI) + (0.50 * (z_AB * z_AA)), # Severe Bottleneck
    (0.40 * z_AB) - (0.30 * z_CMI) + (0.10 * z_AA)           # Minor Frictional Delay
)

downtime_days = (
    9.0
    + 1.65 * z_PGA
    + 0.85 * z_PGV
    - 0.70 * z_FD
    + governance_penalty
    + 0.75 * z_HD
    + 0.35 * maintenance_late
    + 0.30 * soil_soft
    + 0.25 * winter_season
    + 0.55 * (z_PGA * soil_soft) # Physical Interaction (Liquefaction)
    + epsilon
)

downtime_days = np.maximum(downtime_days, 0.5)
prolonged_disruption = (downtime_days > 9.0).astype(int)


# =============================================================================
# 5. BUILD DATAFRAME AND EXPORT SCENARIOS
# =============================================================================

df = pd.DataFrame({
    "Mw": Mw, "PGA": PGA, "PGV": PGV, "fault_distance_km": fault_distance_km,
    "soil_soft": soil_soft, "approval_backlog": approval_backlog,
    "contractor_mobilization_index": contractor_mobilization_index,
    "historical_downtime": historical_downtime,
    "active_approval_authorities": active_approval_authorities,
    "maintenance_late": maintenance_late, "winter_season": winter_season,
    "downtime_days": downtime_days, "prolonged_disruption": prolonged_disruption
})

safe_to_csv(df, "Synthetic_Disruption_Scenarios.csv", index=False)


# =============================================================================
# 6. CORRELATION VALIDATION AND FIGURES
# =============================================================================

print("\n[INFO] Validating and saving Copula correlations...")
realized_physical_corr = df[["Mw", "fault_distance_km", "PGA", "PGV"]].corr(method="spearman")
realized_governance_corr = df[["approval_backlog", "contractor_mobilization_index", "historical_downtime", "active_approval_authorities"]].corr(method="spearman")

safe_to_csv(realized_physical_corr, "Realized_Physical_Spearman_Correlation.csv")
safe_to_csv(realized_governance_corr, "Realized_Governance_Spearman_Correlation.csv")

save_correlation_heatmap(realized_physical_corr, "Realized Physical Hazard Spearman Correlation", "Figure_Physical_Copula_Realized_Correlation.png")
save_correlation_heatmap(realized_governance_corr, "Realized Governance Spearman Correlation", "Figure_Governance_Copula_Realized_Correlation.png")
create_pipeline_figure()


# =============================================================================
# 7. FEATURE SETS AND STRICT 70/15/15 SPLIT
# =============================================================================

physical_features = ["PGA", "PGV", "fault_distance_km"]
governance_features = ["approval_backlog", "contractor_mobilization_index", "active_approval_authorities"]
vulnerability_context_features = ["historical_downtime", "maintenance_late", "soil_soft", "winter_season"]

model_features = physical_features + governance_features + vulnerability_context_features
physical_only_features = physical_features + vulnerability_context_features

X = df[model_features]
y_class = df["prolonged_disruption"]
y_reg = df["downtime_days"]

# Classification Split: 85% Train (with 10-fold CV), 15% Independent Holdout Test
X_train, X_test, y_train, y_test = train_test_split(
    X, y_class, test_size=0.15, stratify=y_class, random_state=RANDOM_SEED
)

# Regression Targets strictly aligned to Classification indices
y_train_reg = y_reg.loc[X_train.index]
y_test_reg = y_reg.loc[X_test.index]

# =============================================================================
# 8. CLASSIFICATION MODEL BENCHMARK
# =============================================================================

classification_models = {
    "GBM": GradientBoostingClassifier(learning_rate=0.05, max_depth=6, n_estimators=500, subsample=0.8, random_state=RANDOM_SEED),
    "Tuned-GBM": GradientBoostingClassifier(learning_rate=0.03, max_depth=3, n_estimators=300, subsample=0.8, min_samples_leaf=5, random_state=RANDOM_SEED),
    "Random Forest": RandomForestClassifier(n_estimators=300, max_depth=10, min_samples_split=10, bootstrap=True, random_state=RANDOM_SEED)
}

if XGBOOST_AVAILABLE:
    classification_models["XGBoost"] = XGBClassifier(learning_rate=0.05, max_depth=5, n_estimators=400, subsample=0.8, colsample_bytree=0.8, eval_metric="logloss", random_state=RANDOM_SEED)

classification_results = []
cv = StratifiedKFold(n_splits=10, shuffle=True, random_state=RANDOM_SEED)
fitted_classifiers = {}

print("\n================ CLASSIFICATION BENCHMARK ================")
print(f"{'Model':<15} | {'Acc':<6} | {'AUC':<6} | {'F1':<6}")
print("-" * 45)

for model_name, model in classification_models.items():
    model.fit(X_train, y_train)
    fitted_classifiers[model_name] = model

    y_pred = model.predict(X_test)
    y_prob = model.predict_proba(X_test)[:, 1]

    holdout_acc = accuracy_score(y_test, y_pred)
    holdout_auc = roc_auc_score(y_test, y_prob)
    holdout_f1 = f1_score(y_test, y_pred)

    cv_acc = cross_val_score(model, X_train, y_train, cv=cv, scoring="accuracy")
    train_acc = accuracy_score(y_train, model.predict(X_train))

    classification_results.append({
        "Model": model_name,
        "Holdout_Accuracy": holdout_acc,
        "Holdout_AUC_ROC": holdout_auc,
        "Holdout_F1_Score": holdout_f1,
        "CV_Accuracy_Mean": cv_acc.mean(),
        "CV_Accuracy_SD": cv_acc.std(),
        "Training_Accuracy": train_acc,
        "Train_CV_Gap": train_acc - cv_acc.mean()
    })
    print(f"{model_name:<15} | {holdout_acc:.3f}  | {holdout_auc:.3f}  | {holdout_f1:.3f}")

safe_to_csv(pd.DataFrame(classification_results), "Classification_Model_Benchmark.csv", index=False)

# =============================================================================
# 9. PRIMARY MODEL SELECTION
# =============================================================================

PRIMARY_MODEL_NAME = "Tuned-GBM"
primary_model = fitted_classifiers[PRIMARY_MODEL_NAME]

classification_results_df = pd.DataFrame(classification_results)
primary_metrics = classification_results_df[classification_results_df["Model"] == PRIMARY_MODEL_NAME].iloc[0]


# =============================================================================
# 10. REGRESSION MODEL BENCHMARK FOR CONTINUOUS DOWNTIME
# =============================================================================

regression_models = {
    "GBM Regressor": GradientBoostingRegressor(learning_rate=0.05, max_depth=6, n_estimators=500, subsample=0.8, random_state=RANDOM_SEED),
    "Random Forest Regressor": RandomForestRegressor(n_estimators=300, max_depth=10, min_samples_split=10, bootstrap=True, random_state=RANDOM_SEED)
}

if XGBOOST_AVAILABLE:
    regression_models["XGBoost Regressor"] = XGBRegressor(learning_rate=0.05, max_depth=5, n_estimators=400, subsample=0.8, colsample_bytree=0.8, objective="reg:squarederror", random_state=RANDOM_SEED)

regression_results = []
print("\n================ REGRESSION BENCHMARK ================")
print(f"{'Model':<25} | {'RMSE':<6} | {'MAE':<6} | {'R2':<6}")
print("-" * 55)

for model_name, model in regression_models.items():
    model.fit(X_train, y_train_reg)
    y_reg_pred = model.predict(X_test)
    
    model_rmse = rmse(y_test_reg, y_reg_pred)
    model_mae = mean_absolute_error(y_test_reg, y_reg_pred)
    model_r2 = r2_score(y_test_reg, y_reg_pred)
    
    regression_results.append({"Model": model_name, "RMSE_days": model_rmse, "MAE_days": model_mae, "R2": model_r2})
    print(f"{model_name:<25} | {model_rmse:.3f}  | {model_mae:.3f}  | {model_r2:.3f}")

safe_to_csv(pd.DataFrame(regression_results), "Regression_Model_Benchmark.csv", index=False)


# =============================================================================
# 11. PERMUTATION IMPORTANCE — PRIMARY MODEL
# =============================================================================

print("\n================ PERMUTATION IMPORTANCE (Top 5) ================")
perm = permutation_importance(primary_model, X_test, y_test, n_repeats=30, random_state=RANDOM_SEED, scoring="accuracy")
perm_df = pd.DataFrame({
    "Feature": X_test.columns, 
    "Mean_Accuracy_Drop": perm.importances_mean, 
    "Std_Deviation": perm.importances_std
}).sort_values("Mean_Accuracy_Drop", ascending=False)

perm_df["Rank"] = np.arange(1, len(perm_df) + 1)
safe_to_csv(perm_df[["Rank", "Feature", "Mean_Accuracy_Drop", "Std_Deviation"]], "Tuned-GBM_Permutation_Importance_All_Features.csv", index=False)
print(perm_df[["Rank", "Feature", "Mean_Accuracy_Drop"]].head(5).to_string(index=False))


# =============================================================================
# 12. FEATURE ABLATION — PRIMARY MODEL
# =============================================================================

print("\n================ FEATURE ABLATION TEST ================")
primary_physical_model = GradientBoostingClassifier(learning_rate=0.03, max_depth=3, n_estimators=300, subsample=0.8, min_samples_leaf=5, random_state=RANDOM_SEED)
primary_physical_model.fit(X_train[physical_only_features], y_train)

physical_accuracy = accuracy_score(y_test, primary_physical_model.predict(X_test[physical_only_features]))
physical_auc = roc_auc_score(y_test, primary_physical_model.predict_proba(X_test[physical_only_features])[:, 1])
ablation_uplift = primary_metrics["Holdout_Accuracy"] - physical_accuracy

ablation_df = pd.DataFrame([
    {"Model": "Physical/Context-only Tuned-GBM", "Holdout_Accuracy": physical_accuracy, "AUC_ROC": physical_auc},
    {"Model": "Hybrid Tuned-GBM", "Holdout_Accuracy": primary_metrics["Holdout_Accuracy"], "AUC_ROC": primary_metrics["Holdout_AUC_ROC"]}
])
ablation_df["Accuracy_Improvement"] = [0.0, ablation_uplift]
safe_to_csv(ablation_df, "Tuned-GBM_Feature_Ablation_Test.csv", index=False)

print(ablation_df[["Model", "Holdout_Accuracy", "Accuracy_Improvement"]].to_string(index=False))


# =============================================================================
# 13. SHAP ANALYSIS — PRIMARY MODEL
# =============================================================================

if SHAP_AVAILABLE:
    print("\n================ SHAP CATEGORY SHARES ================")
    shap_values = safe_shap_values(primary_model, X_test)
    mean_abs_shap = np.abs(shap_values).mean(axis=0)

    shap_df = pd.DataFrame({"Feature": X_test.columns, "Mean_abs_SHAP": mean_abs_shap}).sort_values("Mean_abs_SHAP", ascending=False)
    shap_df["Rank"] = np.arange(1, len(shap_df) + 1)
