def nearest_positive_definite(corr):
    """Ensures that a correlation matrix is strictly positive definite."""
    corr = np.asarray(corr, dtype=float)
    eigvals, eigvecs = np.linalg.eigh(corr)
    eigvals[eigvals < 1e-8] = 1e-8
    corr_pd = eigvecs @ np.diag(eigvals) @ eigvecs.T
    d = np.sqrt(np.diag(corr_pd))
    corr_pd = corr_pd / np.outer(d, d)
    return corr_pd

def gaussian_copula_samples(n, corr, random_state=42):
    """Generates correlated uniform samples using a Gaussian copula."""
    local_rng = np.random.default_rng(random_state)
    corr_pd = nearest_positive_definite(corr)
    z = local_rng.multivariate_normal(mean=np.zeros(corr_pd.shape[0]), cov=corr_pd, size=n)
    return norm.cdf(z)

def zscore(x):
    """Standardizes an array to zero mean and unit variance."""
    x = np.asarray(x)
    return (x - np.mean(x)) / np.std(x, ddof=1)

def rmse(y_true, y_pred):
    """Calculates Root Mean Square Error."""
    return np.sqrt(mean_squared_error(y_true, y_pred))

def safe_to_csv(df, filename, **kwargs):
    """Saves DataFrame to CSV, with fallback handling for permission errors."""
    path = os.path.join(OUTPUT_DIR, filename)
    kwargs.setdefault("encoding", "utf-8-sig")
    try:
        df.to_csv(path, **kwargs)
        return path
    except PermissionError:
        base, ext = os.path.splitext(filename)
        fallback = os.path.join(OUTPUT_DIR, f"{base}_fallback{ext}")
        df.to_csv(fallback, **kwargs)
        return fallback

def save_correlation_heatmap(corr_df, title, filename):
    """Generates and saves a high-resolution Spearman correlation heatmap."""
    labels = corr_df.columns.tolist()
    values = corr_df.values
    fig, ax = plt.subplots(figsize=(7, 6))
    im = ax.imshow(values, vmin=-1, vmax=1, cmap="coolwarm")
    
    ax.set_xticks(np.arange(len(labels)))
    ax.set_yticks(np.arange(len(labels)))
    ax.set_xticklabels(labels, rotation=45, ha="right")
    ax.set_yticklabels(labels)
    
    for i in range(values.shape[0]):
        for j in range(values.shape[1]):
            ax.text(j, i, f"{values[i, j]:.2f}", ha="center", va="center", fontsize=9, color="black")
            
    ax.set_title(title, fontsize=12, fontweight="bold")
    fig.colorbar(im, ax=ax, label="Spearman Correlation")
    fig.tight_layout()
    fig.savefig(os.path.join(OUTPUT_DIR, filename), dpi=600, bbox_inches="tight")
    plt.close(fig)

def draw_box(ax, xy, width, height, text, fontsize=9):
    """Helper to draw a styled box for the pipeline architecture figure."""
    box = FancyBboxPatch(
        xy, width, height, boxstyle="round,pad=0.15,rounding_size=0.15", 
        linewidth=1.0, edgecolor="black", facecolor="#F7F7F7", mutation_scale=2, zorder=2
    )
    ax.add_patch(box)
    ax.text(xy[0] + width / 2, xy[1] + height / 2, text, ha="center", va="center", 
            fontsize=fontsize, family="serif", wrap=True)
    return box

def draw_arrow(ax, start, end, text=None, text_offset=(0, 0), fontsize=8):
    """Helper to draw a styled connection arrow for the pipeline architecture figure."""
    arrow = ConnectionPatch(
        xyA=start, coordsA="data", xyB=end, coordsB="data", 
        arrowstyle="-|>,head_length=6,head_width=4", linewidth=1.0, color="black", 
        shrinkA=0, shrinkB=0, mutation_scale=10, zorder=1
    )
    ax.add_artist(arrow)
    if text:
        ax.text((start[0] + end[0]) / 2 + text_offset[0], (start[1] + end[1]) / 2 + text_offset[1], 
                text, ha="center", va="center", fontsize=fontsize, family="serif", 
                backgroundcolor="#FFFFFF")
    return arrow

